# KaushalForge — .gitignore
# Proprietary + private-safe: nothing personal, generated, or machine-specific is tracked.

# --- Personal data & generated outputs (regenerated each run; folders kept via .gitkeep) ---
config.yaml
inbox/*
!inbox/.gitkeep
work/*
!work/.gitkeep
output/*
!output/.gitkeep

# --- Installed engine / machine-specific ---
engine/.bin/
engine/.tectonic_path

# --- LaTeX build artifacts (regenerated by engine/build_pdfs.py) ---
*.pdf
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
