# KaushalForge — .gitignore
# Proprietary + private-safe: nothing personal, generated, or machine-specific is tracked.
# Merged ruleset = KaushalForge privacy rules (below — never relax) + the project-templates
# python-tool baseline (Python / Node / build / env / IDE / OS), de-duplicated.

# ============================================================================
# KaushalForge privacy rules — PERSONAL DATA & GENERATED OUTPUT (never remove)
# ============================================================================
# Regenerated each run; folders are kept via .gitkeep.
config.yaml
inbox/*
!inbox/.gitkeep
work/*
!work/.gitkeep
output/*
!output/.gitkeep

# Installed engine / machine-specific
engine/.bin/
engine/.tectonic_path

# LaTeX build artifacts (regenerated by engine/build_pdfs.py)
*.pdf
*.aux
*.out
*.fls
*.fdb_latexmk
*.synctex.gz

# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.lcov

# ============================================================================
# Node / JS
# ============================================================================
node_modules/
vendor/
coverage/
.nyc_output/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================================================
# Build output
# ============================================================================
build/
dist/
out/
target/
*.class
*.jar
*.war

# ============================================================================
# Logs & archives
# ============================================================================
*.log
*.zip
*.tar.gz
*.rar
*.7z

# ============================================================================
# Environment & secrets
# ============================================================================
.env
.env.*
!.env.example
credentials.json
*.pem
*.key

# ============================================================================
# IDE / editor
# ============================================================================
.idea/
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
*.swp
*.swo
*~

# ============================================================================
# OS cruft
# ============================================================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
